# Copy this file to .env (git-ignored) and fill in your own values.
# Variables already set in the environment take precedence over this file.

# Required: OpenAI API key used by all scripts.
OPENAI_API_KEY=your_openai_api_key

# Required: SEC asks automated clients to identify themselves with contact details.
SEC_USER_AGENT=ai-investment-thesis/1.0 your-email@example.com

# Optional: default OpenAI model (the code falls back to gpt-4.1-mini).
OPENAI_MODEL=gpt-6.1-sol
